# Bharat Chronicle - Environment Configuration
# Node environment (development / production)
NODE_ENV=development
PORT=5000

# Client Origin (CORS)
CLIENT_URL=http://localhost:5173

# MySQL Database Configuration (Matches cPanel MySQL Database setup)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bharat_chronicle_db
DB_USER=root
DB_PASSWORD=

# Session / JWT Secrets
JWT_SECRET=super_secret_editorial_news_jwt_key_replace_in_production
JWT_EXPIRES_IN=7d

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
