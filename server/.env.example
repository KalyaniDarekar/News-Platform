# Bharat Chronicle - Environment Configuration
# Node environment (development / production)
NODE_ENV=development
PORT=5000

# Client Origin (CORS)
CLIENT_URL=http://localhost:5173

# MySQL Database Configuration (Supports direct URI e.g. Aiven Cloud / Railway or individual keys)
DB_URI=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bharat_chronicle_db
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# Session / JWT Secrets
JWT_SECRET=super_secret_editorial_news_jwt_key_replace_in_production
JWT_EXPIRES_IN=7d

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Cron Job Secret (shared between cPanel cron command and this server)
# Leave blank in local dev — the endpoint is open when this is unset.
# In production, set a long random string and pass it via -H "x-cron-secret: VALUE"
CRON_SECRET=
