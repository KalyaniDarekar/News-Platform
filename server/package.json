{
  "name": "janta-journal-api",
  "version": "1.0.0",
  "description": "Production-ready backend API for Janta Journal News Platform (cPanel/Node.js/MySQL)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch-path=config --watch-path=controllers --watch-path=middleware --watch-path=routes --watch-path=services --watch-path=validators --watch-path=database --watch-path=server.js server.js",
    "db:migrate": "node database/migrate.js",
    "cron:process": "node cron/expiry-processor.js",
    "test": "node --test test/**/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "mysql2": "^3.12.0",
    "zod": "^4.6.7"
  },
  "keywords": [
    "news",
    "cms",
    "publishing",
    "express",
    "mysql",
    "cpanel"
  ],
  "author": "JANTA JOURNAL Media Group",
  "license": "ISC"
}
